# 本ファイルをコピーして .env を作成し、値を設定すること。.env は Git にコミットしない。

# ---- AiNA MyPage（フォームログイン）----
AINA_LOGIN_URL=https://mypage.ai-na.co.jp/login
AINA_LOGIN_ID=akihiro.sato.vagabond@gmail.com
AINA_LOGIN_PASSWORD=1225Rainbow

# 取得対象URL（そのまま利用可）
AINA_SCHEDULE_URL_COMPASS=https://mypage.ai-na.co.jp/user/compass
AINA_SCHEDULE_URL_LIVE_COURSE=https://mypage.ai-na.co.jp/user/live-course

# ---- Google カレンダー連携 ----
GOOGLE_CALENDAR_ID=vagabond.wbnw@gmail.com
# 認証は OAuth またはサービスアカウント等、実装に合わせて追加する

# ---- 同期ジョブ ----
# 前回取得結果の保存先（JSON ファイルパス）
STATE_FILE_PATH=./data/sync-state.json

# 実行間隔（Cron 式）。任意。例: "0 * * * *" = 毎時0分
# SYNC_INTERVAL_CRON=0 * * * *

# Vercel Cron から API を呼ぶ場合の Bearer トークン（未設定の場合は検証しない）
# CRON_SECRET=

# ---- Prisma（SQLite）----
DATABASE_URL=file:./dev.db
